function renderCart(){let entries=Object.entries(cart).filter(([id,q])=>q>0),qty=entries.reduce((s,[id,q])=>s+q,0),sum=entries.reduce((s,[id,q])=>s+products.find(p=>p.id===id).price*q,0);$('#count').textContent=qty;$('#total').textContent=money(sum);const limit=$('#cartLimit');if(limit)limit.textContent='Максимум заказа: '+caps[currency]+' '+symbols[currency];$('#cartItems').innerHTML=entries.length?entries.map(([id,q])=>{let p=products.find(x=>x.id===id);return `<div class="cart-line"><span>${p.emoji} ${p.name}<br><small style="color:#888">${money(p.price)} × ${q}</small></span><span class="qty"><button data-minus="${id}">−</button>${q}<button data-plus="${id}">+</button></span></div>`}).join(''):'<p style="color:#888;text-align:center;padding:22px">Корзина пока пустая. Добавь что-нибудь крутое! 🎮</p>'}
document.addEventListener('click',e=>{let a=e.target.closest('[data-add]'),plus=e.target.closest('[data-plus]'),minus=e.target.closest('[data-minus]');if(a)add(a.dataset.add,a);if(plus){if(canAdd(plus.dataset.plus)){cart[plus.dataset.plus]++;sound(700,.07);renderCart()}else{toast('Достигнут лимит корзины: '+caps[currency]+' '+symbols[currency]);sound(220,.12)}}if(minus){cart[minus.dataset.minus]--;if(cart[minus.dataset.minus]<=0)delete cart[minus.dataset.minus];sound(360,.07);renderCart()}});
$('#productSearch').addEventListener('input',e=>{searchTerm=e.target.value.trim().toLowerCase();render()});$('#currency').addEventListener('change',e=>{currency=e.target.value;render();if(cartBaseTotal()*rates[currency]>caps[currency]+1e-8)toast('В этой валюте корзина превышает лимит. Уменьши заказ.');sound(500,.08)});$('#modeTabs').addEventListener('click',e=>{let b=e.target.closest('[data-mode]');if(!b)return;mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t===b));render();sound(480,.07)});
$('#openCart').onclick=()=>{$('#cartModal').classList.add('show');sound(520,.08)};$('#closeCart').onclick=()=>$('#cartModal').classList.remove('show');$('#cartModal').addEventListener('click',e=>{if(e.target.id==='cartModal')$('#cartModal').classList.remove('show')});
const PROFILE_KEY='tewocraft_profile_v1',ORDERS_KEY='tewocraft_orders_v1';
function readProfile(){try{return JSON.parse(localStorage.getItem(PROFILE_KEY)||'{}')}catch(e){return {}}}
function readOrders(){try{return JSON.parse(localStorage.getItem(ORDERS_KEY)||'[]')}catch(e){return []}}
function updateDrawerProfile(){const p=readProfile();$('#drawerUserName').textContent=p.nick||'Мой профиль';$('#drawerUserHint').textContent=p.contact||'Сохрани ник и контакт в профиле'}
function renderHistory(){const list=readOrders();$('#purchaseHistory').innerHTML=list.length?list.slice().reverse().map(o=>`<div class="history-item"><b>${o.items.map(i=>i.name+' × '+i.qty).join(', ')}</b><small>Заказ ${o.id} · ${o.date} · ${o.total}</small><span class="status-demo">${o.status}</span></div>`).join(''):'<p class="notice">Пока нет заказов. Здесь будут отображаться заявки, оформленные в этом браузере.</p>'}
function openProfile(){const p=readProfile();$('#profileNick').value=p.nick||'';$('#profileContact').value=p.contact||'';renderHistory();$('#profileModal').classList.add('show');sound(540,.08)}
$('#saveProfile').onclick=()=>{const nick=$('#profileNick').value.trim(),contact=$('#profileContact').value.trim();if(nick&&!/^[A-Za-z0-9_]{3,16}$/.test(nick)){toast('Проверь ник Minecraft (3–16 символов)');return}if(contact&&!(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(contact)||/^@?[A-Za-z0-9_]{5,32}$/.test(contact))){toast('Проверь Email или Telegram');return}localStorage.setItem(PROFILE_KEY,JSON.stringify({nick,contact}));updateDrawerProfile();toast('Профиль сохранён на этом устройстве');sound(680,.1);};
$('#openProfile').onclick=()=>{closeDrawer();openProfile()};$('#closeProfile').onclick=()=>$('#profileModal').classList.remove('show');$('#profileModal').addEventListener('click',e=>{if(e.target.id==='profileModal')$('#profileModal').classList.remove('show')});
$('#clearHistory').onclick=()=>{if(confirm('Удалить историю заказов из этого браузера?')){localStorage.removeItem(ORDERS_KEY);renderHistory();toast('История очищена')}};
$('#checkout').onclick=()=>{if(cartBaseTotal()*rates[currency]>caps[currency]+1e-8){toast('Превышен лимит корзины: '+caps[currency]+' '+symbols[currency]);sound(220,.12);return}if(!Object.keys(cart).length){toast('Сначала добавь товар в корзину 🙂');sound(220,.12);return}const nick=$('#nickname').value.trim();if(!nick){toast('Введи игровой ник!');$('#nickname').focus();sound(220,.12);return}const contact=$('#customerContact').value.trim();const validEmail=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(contact);const validTelegram=/^@?[A-Za-z0-9_]{5,32}$/.test(contact);if(!contact||(!validEmail&&!validTelegram)){toast('Введи корректный Email или Telegram!');$('#customerContact').focus();sound(220,.12);return}const order={id:'TW-'+Date.now().toString().slice(-8),date:new Date().toLocaleString('ru-RU'),items:Object.entries(cart).map(([id,qty])=>({name:products.find(p=>p.id===id).name,qty})),total:money(cartBaseTotal()),status:'Демо-заявка · НЕ ОПЛАЧЕНО'};const orders=readOrders();orders.push(order);localStorage.setItem(ORDERS_KEY,JSON.stringify(orders));localStorage.setItem(PROFILE_KEY,JSON.stringify({nick,contact}));updateDrawerProfile();cart={};render();$('#cartModal').classList.remove('show');toast('Заявка сохранена в профиле. Оплата пока отключена');sound(620,.14);};
const discordSocial=$('#discordSocial');
if(discordSocial)discordSocial.addEventListener('click',async()=>{
  try{await navigator.clipboard.writeText('@aplkody153');toast('Discord ник скопирован: @aplkody153')}
  catch(e){toast('Discord: @aplkody153')}
  sound(620,.1,'triangle');
});

const drawer=$('#sideDrawer'),backdrop=$('#drawerBackdrop');
function openDrawer(){document.body.classList.add('drawer-open');$('#menuToggle').setAttribute('aria-expanded','true');backdrop.setAttribute('aria-hidden','false');sound(460,.08)}
function closeDrawer(){document.body.classList.remove('drawer-open');$('#menuToggle').setAttribute('aria-expanded','false');backdrop.setAttribute('aria-hidden','true')}
$('#menuToggle').onclick=openDrawer;$('#closeDrawer').onclick=closeDrawer;backdrop.onclick=closeDrawer;
function closeDrawerIfLink(e){if(e.target.closest('.drawer-link'))closeDrawer()}
drawer.addEventListener('click',closeDrawerIfLink);
const supportForm=$('#supportForm');if(supportForm)supportForm.addEventListener('submit',e=>{e.preventDefault();const topic=$('#supportTopic').value,nick=$('#supportNick').value.trim(),msg=$('#supportMessage').value.trim();if(!msg){toast('Напиши сообщение');return}const body=`Тема: ${topic}%0D%0AНик Minecraft: ${encodeURIComponent(nick||'не указан')}%0D%0A%0D%0A${encodeURIComponent(msg)}`;window.location.href=`mailto:tewocraft.official@gmail.com?subject=${encodeURIComponent('Поддержка TewoCraft — '+topic)}&body=${body}`;sound(600,.1)});
updateDrawerProfile();
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeDrawer();$('#profileModal').classList.remove('show');$('#cartModal').classList.remove('show')}});
if('IntersectionObserver' in window){const io=new IntersectionObserver(entries=>entries.forEach(x=>{if(x.isIntersecting){x.target.classList.add('visible');io.unobserve(x.target)}}),{threshold:.08});document.querySelectorAll('.section,.banner,.step,.product').forEach(el=>{el.classList.add('reveal');io.observe(el)})}
render();
